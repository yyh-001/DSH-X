{
  "name": "dsh-x-sync",
  "version": "0.1.1",
  "description": "把 dsh 的会话记录、附件、插件配置、技能和记忆同步到 S3 兼容存储 / WebDAV / 本地目录 / 单个 ZIP：和 DSH-X 启动器共用同一只桶、同一套目录结构，双向并集合并、不丢插件。Sync DSH sessions, attachments, plugin config, skills and memory to S3-compatible storage / WebDAV / a local folder / a single ZIP — same bucket and layout as the DSH-X launcher, merged in both directions.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test",
    "sync-engine": "node scripts/sync-engine.mjs"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "sync",
    "s3",
    "webdav",
    "backup"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-locale"
      ]
    },
    "compatibility": {
      "dsh": ">=0.1.6"
    }
  },
  "dshhub": {
    "schemaVersion": 1,
    "displayName": "DSH-X Sync",
    "summary": "会话、附件、插件配置、技能、记忆同步到 S3 兼容存储 / WebDAV / 本地目录 / ZIP。与 DSH-X 启动器共用同一只桶与目录结构；插件清单双向并集合并，两台机器都不丢插件。支持 agent 工具触发（「同步一下」）与设置页面板操作。",
    "categories": [
      "数据与备份",
      "工具"
    ],
    "homepage": "https://github.com/yyh-001/DSH-X"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yyh-001/DSH-X.git"
  },
  "author": "yyh",
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": ">=0.1.6",
    "@deepseek-ai/dsh-client-ui-renderer": ">=0.1.6",
    "@deepseek-ai/dsh-client-locale": ">=0.1.6"
  }
}
